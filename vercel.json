{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:production",
  "outputDirectory": "vercel-dist",
  "installCommand": "npm ci",
  "trailingSlash": true,
  "redirects": [
    { "source": "/", "destination": "/mobile/", "permanent": false },
    { "source": "/legacy/:path*", "destination": "https://maeum-gyeol.justice-parkit.chatgpt.site/legacy/:path*", "permanent": false }
  ],
  "headers": [
    { "source": "/mobile/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/mobile/cloud-config.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "no-referrer" }] }
  ]
}
